# Copiar a .env y completar. NUNCA subir .env a un repositorio.
APP_ENV=prod
# true SOLO en dev/staging: un usuario aprobado entra a todos los roles
MODO_PRUEBA=false

# SQL Server 2012 (base sapinfo, tablas ZTLOGI_*)
DB_SERVER=192.168.30.5\PRD
DB_NAME=sapinfo
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server
# true = autenticación de Windows (ignora DB_USER/DB_PASSWORD)
DB_TRUSTED=false

# Seguridad
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=30
# Usuario administrador que se crea al inicializar la base si no existe
ADMIN_USUARIO=admin
ADMIN_PASSWORD=

# Reglas de negocio (hora de Argentina)
TZ=America/Argentina/Buenos_Aires
CIERRE_DISPONIBILIDAD=20:00
CIERRE_RELEVAMIENTO=21:00
TOLERANCIA_DEMORA_MIN=5

# Archivos (fotos de remitos) y lectura por IA (opcional; sin clave la carga es manual)
DATA_DIR=data
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5-5
VISION_DAILY_LIMIT_PER_USER=50

# Servidor: HOST=0.0.0.0 escucha simultáneamente en localhost y en la IP de red del equipo
HOST=0.0.0.0
PORT=8000
